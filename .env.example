# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENROUTER_API_KEY: Optional API key for OpenRouter (openrouter.ai) models.
# Configure this via the Secrets panel in the AI Studio UI or in App Settings.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

